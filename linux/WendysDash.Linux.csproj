<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
    <AssemblyName>WendysDash</AssemblyName>
    <RootNamespace>WendysDash</RootNamespace>
    <Version>1.1.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationIcon>../assets/app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <Compile Include="../src/PatchService.cs" Link="PatchService.cs" />
    <Compile Include="../src/GameProcessGuard.cs" Link="GameProcessGuard.cs" />
    <Compile Include="LinuxSteamLocator.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="MainWindow.cs" />
    <Compile Include="SmokeFixture.cs" />
  </ItemGroup>
</Project>
